{
  "name": "workie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "playwright:install": "playwright install chromium firefox webkit",
    "test:e2e": "npm run playwright:install && playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check src e2e eslint-rules index.html vite.config.ts playwright.config.ts vitest.setup.ts eslint.config.js prettier.config.js tsconfig.json tsconfig.app.json tsconfig.node.json package.json"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
